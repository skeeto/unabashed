#!/bin/sh
# Run bash 5.3's own run-* tests on our POSIX build, in a container
#
#   tools/oracle-posix [-v] [-m MANIFEST] SHELL [NAME...]
#
# SHELL is a Linux build of unabashed (make unabashed, in WSL or Linux).
# Each NAME runs as run-all runs it, "sh run-NAME" in the suite's
# directory with THIS_SH our shell, and passes (PASS) if it prints
# nothing but "warning:" lines. A failing test is run again with the
# image's bash 5.3 as THIS_SH: if bash prints exactly the same, the
# failure is this environment's (BASH: no terminal, missing locales),
# else it is ours (FAIL). -v shows each FAIL's output as a diff against
# bash's. Without names it runs category c (notes/research/tests.md),
# the tests that need real processes; "all" runs every run-* test.
#
# With -m, the results are compared with MANIFEST, lines of "NAME
# RESULT" (t/oracle-posix.txt): any test doing worse than listed is
# reported and the exit status is 1; one doing better is noted.
#
# One container from the oracle image (tools/Dockerfile.bash53) for the
# whole run: --network none, read-only but for tmpfs /tmp and workdir,
# uid 1000, no capabilities. The suite is unpacked afresh from the
# repository's bash-5.3.tar.gz for each test, and /tmp emptied. PATH
# holds bash's helpers and the image's real coreutils, never the fakes.
#
# Environment:
#   ORACLE_IMAGE    oracle image (default unabashed/bash53)
#   ORACLE_TIMEOUT  seconds per test (default 300)
set -eu

image=${ORACLE_IMAGE:-unabashed/bash53}
limit=${ORACLE_TIMEOUT:-300}
category_c='execscript invocation exportfunc varenv posixexp builtins procsub rsh dynvar glob-bracket'

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*';;
esac

verbose=
manifest=
while :; do
    case "${1:-}" in
    -v) verbose=1; shift;;
    -m) manifest=${2:-}; shift 2;;
    *)  break;;
    esac
done
if [ $# -lt 1 ] || [ ! -f "$1" ]; then
    echo "usage: tools/oracle-posix [-v] [-m MANIFEST] SHELL [NAME...|all]" >&2
    exit 2
fi
here=$(cd "$(dirname "$0")/.." && pwd)
shell=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
tarball=$here/bash-5.3.tar.gz
shift
if [ ! -f "$tarball" ]; then
    echo "oracle-posix: $tarball not found" >&2
    exit 1
fi
if command -v cygpath >/dev/null 2>&1; then
    shell=$(cygpath -w "$shell")
    tarball=$(cygpath -w "$tarball")
fi
names=${*:-$category_c}

# Runs inside the container, with the test names as arguments
inner='
B=/home/oracle/bash-5.3
pass=0
total=0
if [ "$*" = all ]; then
    set -- $(tar -tzf /opt/src/bash-5.3.tar.gz | sed -n "s,^bash-5.3/tests/run-,,p" |
             grep -v "^all\$\|^minimal\$\|^gprof\$")
fi
# Run test $1 with THIS_SH a copy of $2, the output in $3
runone() {
    cd /home/oracle
    rm -rf "$B" /tmp/* /tmp/.[!.]* 2>/dev/null
    tar -xzf /opt/src/bash-5.3.tar.gz -C /home/oracle bash-5.3/tests bash-5.3/y.tab.c
    head -c 20000 /dev/zero | tr "\0" "x" >$B/config.h
    head -c 2000 /dev/zero | tr "\0" "x" >$B/version.h
    cp "$2" $B/bash
    cd $B/tests
    env -i LANG=C TZ=UTC HOME=/home/oracle TMPDIR=/tmp \
        PATH=.:/usr/local/bin:/usr/bin:/bin THIS_SH=$B/bash BUILD_DIR=$B \
        BASH_TSTOUT=/tmp/bashtst-1 timeout "$ORACLE_TIMEOUT" sh run-$1 \
        >"$3" 2>&1 </dev/null
    st=$?
    [ $st -eq 124 ] && echo "(timed out after ${ORACLE_TIMEOUT}s)" >>"$3"
    return $st
}
nbash=0
for name; do
    runone "$name" /opt/under/bash /home/oracle/.ours
    st=$?
    bad=$(grep -v "^warning: \|^\$" /home/oracle/.ours | head -c 1)
    total=$((total + 1))
    if [ -z "$bad" ] && [ $st -ne 124 ]; then
        pass=$((pass + 1))
        printf "%-20s PASS\n" "$name"
        continue
    fi
    runone "$name" /usr/local/bin/bash /home/oracle/.bash
    if cmp -s /home/oracle/.ours /home/oracle/.bash; then
        nbash=$((nbash + 1))
        printf "%-20s BASH\n" "$name"
    else
        printf "%-20s FAIL (%d bytes)\n" "$name" $(wc -c </home/oracle/.ours)
        [ -z "$ORACLE_VERBOSE" ] ||
            diff /home/oracle/.bash /home/oracle/.ours | sed "s/^/    /"
    fi
done
echo "$pass of $total pass, $nbash more fail as bash does"
'

results=$(mktemp)
trap 'rm -f "$results"' EXIT
docker run -i --rm --init --network none --read-only \
    --tmpfs /tmp:rw,exec,nosuid,nodev,mode=1777 \
    --tmpfs /home/oracle:rw,exec,nosuid,nodev,uid=1000,gid=1000,mode=755 \
    --workdir /home/oracle --user oracle --hostname oracle \
    --cap-drop ALL --security-opt no-new-privileges \
    --pids-limit 512 --ulimit nofile=1024:1024 \
    --volume="$shell:/opt/under/bash:ro" \
    --volume="$tarball:/opt/src/bash-5.3.tar.gz:ro" \
    -e ORACLE_TIMEOUT="$limit" -e ORACLE_VERBOSE="$verbose" \
    "$image" /bin/sh -c "$inner" sh $names </dev/null | tee "$results"
[ -n "$manifest" ] || exit 0

# Worse than the manifest: PASS > BASH > FAIL
rank() { case $1 in PASS) echo 2;; BASH) echo 1;; *) echo 0;; esac; }
status=0
while read -r name want; do
    case $name in ''|'#'*) continue;; esac
    got=$(awk -v n="$name" '$1 == n { print $2 }' "$results")
    [ -n "$got" ] || continue
    if [ "$(rank "$got")" -lt "$(rank "$want")" ]; then
        echo "REGRESSION: $name $got, manifest $want"
        status=1
    elif [ "$(rank "$got")" -gt "$(rank "$want")" ]; then
        echo "better: $name $got, manifest $want"
    fi
done <"$manifest"
exit $status
