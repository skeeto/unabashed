#!/bin/sh
# Usage: bench/run SHELL... : time each benchmark under each shell,
# after checking that every shell prints the same output. BENCH picks
# the benchmarks (default: all of b1 to b13).
cd "$(dirname "$0")"
for b in ${BENCH:-b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13}; do
    ref=
    for sh in "$@"; do
        out=$("$sh" $b.sh 2>&1 | cksum)
        [ -z "$ref" ] && ref=$out
        [ "$out" = "$ref" ] || echo "$b: $sh output differs"
        start=$(date +%s.%N)
        "$sh" $b.sh >/dev/null 2>&1
        end=$(date +%s.%N)
        awk -v b=$b -v s="$sh" -v t0=$start -v t1=$end \
            'BEGIN { printf "%-4s %-28s %6.2fs\n", b, s, t1 - t0 }'
    done
done
