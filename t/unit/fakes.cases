expr 1 / 0 '|' 1
expr 1 '|' a + 1
expr 0 '&' a + 1
expr 0 '&' 1 : '['
expr 1 '|' 1 : '['
expr '' '|' 1 / 0
expr 3 '|' '(' 1 / 0 ')'
expr 0 '|' 0 '|' 7
expr 1 '&' 2 '&' 0
expr 99999999999999999999 '<' 100000000000000000000
expr -99999999999999999999 '<' -100000000000000000000
expr 99999999999999999999 = 0099999999999999999999
expr substr abc 18446744073709551616 1
expr substr abc 1 -18446744073709551616
expr substr abc -18446744073709551616 1

# seq additions
seq 9223372036854775807 9223372036854775807
