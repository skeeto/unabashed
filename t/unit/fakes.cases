seq 0x1F 0x21
seq 0X10 16
seq 0x 1
seq 0xg 1
seq '  3'
seq '3 '
seq 1 -inf
seq 5 inf 1
seq 1 inf 3
seq INF 1
seq NaN
seq -nan
seq 1 nan 3
seq -w 1e1
seq -w 0x8 0xa
