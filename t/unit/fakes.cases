# Command lines for t/unit/fakes_test.cpp, one per line, each run in
# /home/oracle on a fresh copy of fakes.fixture. The harness parses a
# small subset of bash: words with ' " $'' quoting and backslashes,
# | && || ; and the redirections < > >> 2> 2>> 2>&1 >&2 <<<. No
# expansions or globs: $ * ? [ ] { } ~ must be quoted. Names of bash
# builtins (echo, true, pwd, ...) are given as /opt/fakes/bin paths.

# bash test helpers
recho a 'b c' '' $'\001\037\177' $'x\ty' "d\"e"
recho
zecho a 'b  c' d
zecho
printenv HOME
printenv NOPE
printenv HOM
printenv PATH LANG
printenv | cat
xcase -u lines
xcase -l mixed
xcase mixed
xcase -u < words
xcase -n -u words
xcase -z lines
xcase nofile
cat lines | xcase -l -
xcase lines -u

# cat
cat lines
cat lines words
cat nofile
cat dir
cat lines nofile words
cat nofile lines 2>&1
cat -n words
cat -b words
cat -s blanks
cat -sn blanks
cat -E words
cat -T tabs
cat -A bin
cat -v bin
cat -e nonl
cat -t tabs
cat -n lines words
cat nonl lines
cat - < lines
cat lines - < words
cat lines | cat -n
cat -z lines
cat --foo lines
cat empty
cat 'a b'
cat "it's"
cat $'a\nb'
cat '#x' 'x#' '=' 'a:b' '@' '~' 'a]'
cat ro
cat lnk
cat dangle
cat dirlnk
cat -vET bin
cat <<< 'here string'

# echo, true, false
/opt/fakes/bin/echo a b c
/opt/fakes/bin/echo -n a b
/opt/fakes/bin/echo -e 'a\tb\nc'
/opt/fakes/bin/echo -e 'x\101\0101\x41\x\q\\'
/opt/fakes/bin/echo -e 'stop\cnot' more
/opt/fakes/bin/echo -E 'a\tb'
/opt/fakes/bin/echo -nx z
/opt/fakes/bin/echo -- a
/opt/fakes/bin/echo -neE 'a\tb'
/opt/fakes/bin/echo -e '\0' | od -c
/opt/fakes/bin/echo -e '\e[1m\a\b\f\r\v' | od -c
/opt/fakes/bin/echo
/opt/fakes/bin/true
/opt/fakes/bin/false
/opt/fakes/bin/true --x
/opt/fakes/bin/false || /opt/fakes/bin/echo failed

# rm
rm lines; ls
rm nofile
rm -f nofile; ls
rm
rm -f
rm dir
rm -r dir; ls
rm -rf dir emptydir nofile; ls
rm -R dir; ls
rm .
rm -r .
rm -r dir/..
rm emptydir
rm -d emptydir; ls
rm -d dir
rm ro; ls
rm lnk dangle; ls
rm dirlnk; ls dir
rm -r /
rm -z lines
rm 'a b'
rm "it's"
rm lines lines

# mkdir
mkdir new; ls
mkdir dir
mkdir x/y
mkdir -p x/y/z; ls x x/y
mkdir -p dir/sub
mkdir -p lines/x
mkdir lines
mkdir -m 700 m; ls -ld m | cut -c1-10
mkdir -m u=rwx,go=rx m2; ls -ld m2 | cut -c1-10
mkdir -m 1777 st; ls -ld st | cut -c1-10
mkdir -m g+w gw; ls -ld gw | cut -c1-10
mkdir -m xyz q
mkdir
mkdir -v a b
mkdir -pv p/q
mkdir -z a
mkdir a a
mkdir dangle

# rmdir
rmdir emptydir; ls
rmdir nofile
rmdir lines
rmdir dir
rmdir
mkdir -p a/b/c; rmdir -p a/b/c; ls
rmdir dirlnk
rmdir emptydir emptydir

# touch
touch newf; ls
touch x/y
touch -d xyz lines
touch -d @1000000000 lines; ls -l lines
touch -c nofile; ls
touch -d @0 a b; ls -l a b
touch -t 200102030405.06 t1; ls -l t1
touch -t 0102030405 t2; ls -l t2
touch -d @1000000000 lines; touch -r lines n2; ls -l n2
touch -r nofile n3
touch
touch -d @1000000000.5 frac; ls -l frac
touch dir; ls -ld dir | cut -c1-10
touch -d @2000000000 future; ls -l future

# chmod
chmod 600 lines; ls -l lines | cut -c1-10
chmod +x lines; ls -l lines | cut -c1-10
chmod -r lines; ls -l lines | cut -c1-10
chmod u=rwx,g=rx,o= lines; ls -l lines | cut -c1-10
