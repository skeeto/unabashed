chmod 744 lines; chmod a+X lines; ls -l lines | cut -c1-10
chmod g+u lines; ls -l lines | cut -c1-10
chmod =r lines; ls -l lines | cut -c1-10
chmod 4755 lines; ls -l lines | cut -c1-10
chmod 2644 lines; ls -l lines | cut -c1-10
chmod 4755 lines; chmod 755 lines; ls -l lines | cut -c1-10
chmod 1777 dir; ls -ld dir | cut -c1-10
