chmod 777 lines; chmod -w lines; ls -l lines | cut -c1-10
chmod -w lines; ls -l lines | cut -c1-10
chmod +w ro; ls -l ro | cut -c1-10
chmod o=u-w ro; ls -l ro | cut -c1-10
chmod u-w,g+w lines; ls -l lines | cut -c1-10
chmod a=,u+r lines; ls -l lines | cut -c1-10
chmod go=u lines; ls -l lines | cut -c1-10
chmod +t lines; ls -l lines | cut -c1-10
chmod xyz lines
chmod 8 lines
chmod u+q lines
chmod
chmod 755
chmod 755 nofile
chmod -R go-rwx dir; ls -ld dir dir/a dir/sub dir/sub/c | cut -c1-10
chmod 600 lnk; ls -l lines | cut -c1-10
chmod 755 dangle
chmod -f 755 nofile
chmod a-x,u+w dir; ls -ld dir | cut -c1-10
chmod --foo lines
chmod 644 lines nofile words; ls -l lines words | cut -c1-10

