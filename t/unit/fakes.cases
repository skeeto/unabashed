seq 0.000000000000000001 0.000000000000000001 0.000000000000000003
seq 0.0000000000000000001 1
seq 1 0.5e0 2

# date additions
date -d @0 -R
date -d @1234567890 -Iseconds
date -d @1234567890 -Ih
date -d @1234567890 -Iminutes
date -d @1234567890.5 -Ins
date -d @1234567890 -Idate
date -d @1234567890 -Ix
date -d @1234567890 -R +%s
date -d @253402300799 +%F
date -d @253402300800 +%Y
date -d @-62167219200 +%F
date -d @-62167219201 +%F
date -d @1234567890 '+%+4Y %+6Y %+2Y'
date -d '@  12' +%s
date -d '@ -12' +%s

# basename and dirname -z, chmod and rmdir verbose
basename -z a b | od -c
basename -az a b | od -c
dirname -z a/b c | od -c
chmod -v 600 lines nofile
chmod -c 644 lines
chmod -c 600 lines dir
chmod -v u+s lines
chmod -cf 700 nofile
rmdir -v emptydir nofile
rmdir -pv a/b
mkdir -p a/b; rmdir -pv a/b
rmdir -v dir

# misc fixed paths
mktemp aXXXb | wc -c
mktemp XXXa/b
mktemp -d aXXX.d | wc -c
mktemp -u XXX/
mktemp -t abXXX/
cp -d lnk x; ls -l x | cut -c1
cp -L lnk x; ls -l x | cut -c1
cp -H lnk x; ls -l x | cut -c1
cp -rL dirlnk x; ls -l x | cut -c1
cp -r dirlnk x; ls -ld x | cut -c1
cp -rH dirlnk x; ls -ld x | cut -c1
cp -a lnk x; ls -l x | cut -c1
mv .. x
mv dir/.. x
ln -f lnk lines
ln -sf lnk lines
ln -sf ../oracle/lines lines
ln -f lines dir/lines; ls dir
ln -sfn dir dirlnk; ls dir
head -n ' 3' lines
head -c +3 lines
head -n '	2' lines
tail -n ' 2' lines
tail +2c lines
tail -2b lines | wc -c
tail +2l nonl
tail -1 lines -
tail -1 -- lines
tail +1 lines nonl
tail -3 lines nonl
head -2 lines -3
head -2 -n 3 lines
od -j 0x3 -N 0x4 -c lines
od -j 07 -N 1 -c lines
od -j 1b -c lines
od -j 1x lines
od -N 1kB lines | head -1
od -j 64 lines
od -j 63 lines
od -tx1z -w4 nonl
od -t a -t x1z nonl
od -c lines 10
od -c lines 10.
od -c lines 1b
od -c lines +0x10
od -c lines x
od +5 < lines
od -w8 -t x4 lines
od -w6 -t x4 lines
od -w12 -t x8 lines
uniq -D keys
uniq -D -d dup
uniq -D -u dup
uniq -Di mixed
uniq -D -f1 keys
cut -c 1-2-3,4 lines
cut -f 1-2-3 csv
cut -f 99999999999999999999 csv
cut -f 1-99999999999999999999 csv
cut -d $'\n' -f 2 lines
cut -d $'\n' -f 1,3 -s lines
sort -m dup mixed
sort -mr lines words
sort -m -u dup dup
sort -m nofile lines
sort -k1,0 keys
sort -k1, keys
sort -k1.1x keys
sort -k 2.0 keys
sort -k 1,2.0 keys
sort -k 1.2b keys
sort -bk1 keys
sort -b <<< $'  b\na\n c'
sort -br <<< $'  b\na\n c'
sort -bu <<< $'  a\na'
tr '[a*]' x <<< a
tr a '[b*010x]' <<< a
tr a '[b*0x10]' <<< a
tr a '[b*7]' <<< a
tr a '[=b=]' <<< a
tr '[=a=]' b <<< a
tr -d '[=a=]' <<< a
tr '[:upper:]' '[:lower:][:upper:]' <<< A
tr 'a[:upper:]' 'b[:lower:]' <<< aA
tr -t '[:upper:]a' '[:lower:]' <<< Aa
tr '[:lower:]' '[:upper:]x' <<< ax
tr '[:digit:]' '[:alpha:]' < csv
tr '[:upper:]' '[:digit:]' <<< A
tr '\1000' x <<< $'@0'
tr '\0777' x <<< a
tr '\08' x <<< 8
