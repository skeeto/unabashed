# The rewritten format persists into later passes
C
t '%l(x)%(%Y)T|' 0 31536000
t '%*l(x)Y%s|' 3 a 4 b
t '%hl(x)T%s|' a b
t '%.3l(%H)T|%s' 0 a 1 b
t '%l(%H)T|%l(x)Y|%s' 0 a
t '%(%((%H)T' 0
t '%(a)T(%H)T|' 0 0

# Floating point: strtold's syntax and ranges, glibc's %L conversions
C
t '[%f]' 0 1 -1 3.14159 2.5 -0 1e10 0.1 1e-7
t '[%e|%E]' 0 1 0.1 1e300 1e-300 -2.5e-5 9.9999995 12345.678
