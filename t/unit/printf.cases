t '[%#5q]' 'a b'
t '[%#Q]' ''
t '%q' 'x' 'y' 'z'

# Invalid time specs, including bash's in-place format rewrite
t '[%l(x)Y]'
t '[%hh(x)Y]'
t '%l(x)Y%s|' a b
t '%L(%H'
t '%(%H(x)T'
t '%(%H)T%(x' 0
t '%5(x)Y|'
t '%(x)%s|' a
t '%(()T|' 0
t '%((%H))T|' 0
t '%((%H)T)T|' 0

# %S and %C in the C locale
t '[%.0S]' ab
t '[%5.0S]' ab
t '[%-4.0S]' ab
t '[%C]' ''
t '[%3C]' ''
t '[%lC]' a

# Interactions
tv n 'é%n' n
tv n '%5b%n' 'a' n
tv n '%q%n' 'a b' n
tv n '%(%Y)T%n' 0 n
t '%n' 'a-b'
t '%s%n' x 'é'
t '%s%n%d' x _ 5
t '%n%s' 'a[1]' x
t '%z' x
t '%hs|%Lc|%zd' a b 3
t '%m %s' x
t '%p' x
t '%B' x
t '%I' x
t '%Id' 5

# Locale-dependent cases
U
