t '[%*.*f|%-*.*e]' 12 3 2.71828 12 2 2.71828
t '[%.*g|%.*g|%.*g]' -1 3.14159 0 3.14159 20 3.14159
t '[%.30f]' 0.1 1e-20
t '[%.0a|%.1a|%.2a|%.0a|%.0a]' 1.5 0x1.f8p0 0xf.f8p0 0xfp0 0xf.8p0
t '[%#.3g|%#.2g|%#g|%#.1g|%#.5g]' 9.9999 99.99 999999.7 9.9999 9999.95
t '[%.3g|%g|%.10g]' 0.000099999 0.0000999 1234567.891
t '[%.-5f] [%.-5e] [%.-3d]' 1 2 3
t '%f\n' 1 2 3
t '[%5.1f]' 1e4932 1.18973149535723176502e+4932 1.18973149535723176508e+4932
t '[%.3e]' 3.64519953188247460253e-4951 1.8e-4951 1.9e-4951 3.3621031431120935063e-4932
