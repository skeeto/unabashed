# %q, %Q
t '%q\n' '-' '--' '=' 'a=b' ':' '@' '%' '+x' 'a,b' 'x]' '!x' 'x!'
t '%q\n' '~:~' '=~' ':~' '~~' 'a:b:~c' 'a=b=~' '#~' '~#'
t '%q\n' $'\x7f' $'\xff\'' $'a\x01\'b' $'\x1b[0m' $'\t\n'
t '%q\n' ' ' '  ' '	' $'\x01 '
t '%#q|' '' "'" '"' '$x' '#x' '~x' $'\n'
t '[%.2Q]' 'ab cd'
