# Inputs for regex_diff --record, which writes regex.golden from glibc's
# regcomp/regexec (REG_EXTENDED). Fields are tab-separated: flags (-
# none, i REG_ICASE, u the C.UTF-8 locale), pattern, subject. Bytes
# outside ! to ~, and %, are written %HH, and %00 is an empty field.

# Literals, dot, alternation, grouping
-	abc	xxabcxx
-	a.c	abc
-	a.c	a%0Ac
-	a|b|c	zzc
-	(ab|a)(bc|c)	abc
-	(a|ab)(c|bcd)(d*)	abcd
-	(a*)(b*)	aabbb
-	(a*)+	b
-	(a*)*	b
-	(a?)*	aa
-	(a|)*	aa
-	(|a)	a
-	(a|)	a
-	(|a)+	aa
-	()	x
-	()*	x
-	(()|a)+	aab
-	((a)|b)*	ab
-	((a)|b)*	ba
-	(a|b)*c	ababc
-	x*	%00
-	%00	abc
-	(a)|b	b
-	a(b)?c	ac
-	(a(b)?)+	aba
-	(.)(.)?(.)?	ab

# Leftmost-longest
-	a|ab	abc
-	(a|ab)(c|bcd)	abcd
-	(a+|b+)*	aabba
-	x*y*	zz
-	(wee|week)(knights|night)	weeknights

# Repetition and intervals
-	a{2}	aaa
-	a{2,}	aaaa
-	a{,2}	aaaa
-	a{0}	aaa
-	a{0}b	ab
-	a{1,3}?	aaaa
-	a**	aa
-	a+?	aa
-	(a){2}	aaa
-	(a|b){2,3}	ababa
-	(x?){2}	x
-	(x?){0,3}y	xxy
-	(a*){1,}b	aab
-	a{,}	aaa
-	a{1,2,3}	a
-	a{1\,2}	a
-	a{	a
-	a{1	a
-	a{1,2	a
-	a{}	a
-	a{x}	a
-	a{2,1}	a
-	a{32767}	a
-	a{32768}	a
-	{1}a	a
-	*a	a
-	a|*b	b
-	(+a)	a
-	^*	a
-	$*	a
-	a{1}{2}	aa

# Parentheses and escapes
-	)	a)b
-	a)	a)
-	(	a
-	(a	a
-	a\	a
-	\(a\)	(a)
-	\{	{
-	\|	|
-	\.	a.b
-	\n	n
-	\a	a
-	}	}
-	]	]

# Brackets
-	[abc]	xbx
-	[^abc]	abcd
-	[]a]	]
-	[^]a]	]b
-	[a-]	-
-	[-a]	-
-	[--z]	m
-	[a-c-e]	a
-	[a--]	a
-	[z-a]	a
-	[%80-%FF]	%E9
-	[[:alpha:]]+	12ab3
-	[[:digit:][:space:]]+	a1 2b
-	[[:word:]]	a
-	[[:ALPHA:]]	a
-	[[:alpha:]-z]	a
-	[a-[:digit:]]	a
-	[[.a.]]	a
-	[[.-.]a]	-
-	[[.space.]]	%20
-	[[..]]	a
-	[[=a=]]	a
-	[[=ab=]]	a
-	[[:alpha:	a
-	[a	a
-	[	a
-	[^	a
-	[\]	\
-	[\n]	n
-	[[]	[
-	[a[]	[
-	[[.a.]-c]	b
-	[[..]-a]	a
-	[[:punct:]]+	a,.!b
-	[[:xdigit:]]+	xDEADbeefz
-	[[:upper:][:lower:]]+	1aB2
-	[[:cntrl:]]	a%01b
-	[[:print:]]+	%01ab%20c%7F
-	[[:graph:]]+	%20ab%20
-	[[:blank:]]+	a%20%09%0Ab

# GNU extensions
-	\w+	--ab_1--
-	\W+	ab--cd
-	\s+	a%20%09%0Ab
-	\S+	%20ab%20
-	\bab	xab%20ab
-	ab\b	abx%20ab
-	\Bb	ab
-	\<a	ba%20a
-	a\>	ab%20a
-	\`a	aa
-	a\'	aa
-	\b	%00
-	\B	%00
-	\B	ab
-	\B	.ab
-	\b	.a
-	x*\B	.ab
-	a*\B	ca.
-	a*\B	cax
-	b*\B	_b
-	a*\B	cc

# Anchors and newlines: no REG_NEWLINE, but the automaton sees a
# newline the match consumed
-	^b	a%0Ab
-	%0A^b	a%0Ab
-	(.)^b	a%0Ab
-	a$	a%0Ab
-	a$.	a%0Ab
-	(a)$.	a%0Ab
-	(a$.|a)	a%0Ab
-	a$.|a	a%0Ab
-	a\'.	a%0Ab
-	^$	%00
-	a^b	a^b
-	a$b	a$b
-	x$|y	x
-	(^a|b)+	aab
-	($)*{1,}x	x

# Back-references
-	(a)\1	aa
-	(a)\1	ab
-	(a*)\1	aaaa
-	(a|b)*\1	abb
-	(a*)*\1	aab
-	(a*)*\1	%00
-	(a*)*(b*)\1	%00
-	(a*)*(b*)*\1	bb
-	(a*)+(b*)*\1	%00
-	()\1	x
-	(a)|\1	a
-	(a\1)	a
-	\1(a)	aa
-	(a){0}\1	a
-	(a)(b)(c)(d)(e)(f)(g)(h)(i)\9	abcdefghii
-	((a)|b)\2	aa
-	(a?){2}\1	aa
-	(a|){2}\1	aaa
-	(a|){1,2}\1	%00
-	(){2}\1	%00
-	.1(a*)*\1	x1a
-	(x)(y)?\2	x
-	(a)(b)?\2*c	ac

# Case folding (nocasematch)
i	abc	xABCx
i	[a-c]+	xABCx
i	[^a]	A
i	[[:lower:]]+	aBc
i	[[:upper:]]+	aBc
i	\a	A
i	\A	a
i	(a)\1	aA
i	[Z-a]	a
i	[_-a]	a
i	[[.a.]]	A
i	\w	B

# UTF-8
u	.	%C3%A9
u	.	%FF
u	%FF	%FF
u	..	%C3%A9
u	%C3.	%C3%A9
u	%A9	%C3%A9
u	[%C3%A9]	x%C3%A9
u	[^a]	%C3%A9
u	[^a]	%FF
u	[a-%C3%A9]	b
u	[%80-%FF]	%C3%A9
u	[%80-%FF]	%E2%82%AC
u	%C3%A9*	%C3%A9%C3%A9
u	(%C3%A9|b)+	b%C3%A9b
u	[[=%C3%A9=]]	%C3%A9
u	[[.%C3%A9.]]	%C3%A9
u	\w+	ab_c
u	x*	%C3%A9
u	a*\B	ca.

# Back-references as glibc's get_subexp finds their spans: the initial
# state takes a back-reference whose group closes in it to match empty,
# set or not, so the end is reached through the empty alternative where
# set_regs then cannot place it; only the lowest-numbered close node of
# a group in a state counts; spans whose way went through a ^ after or
# a $ before a newline the match consumed do not count; a reference
# must satisfy what follows it.
-	(|^())\2	a
-	(|^())\2a	ba
-	(|\b())\2	a
-	(|^(a|))\1	a
-	(y|^(a|))\2	a
i	(|y|||^(a|))\2	a
-	(|^())\1a	aabcd
-	(a|\b|())\1\|	c|
-	(a|\B)\1	%60ab
-	(\B|a)\1	%60ab
-	bcd(a|\b)\1	%60a%0A>bcd
i	a(a|\b|\b)\1	%E0a\(|*)%0Aa
i	(a|\b|\`)\1	%E0a\(d*)%0Aa
-	%80|a(\b)\1	``%ED\(),)%0Ba%80c
-	.^(a)\1	%0Aaa
u	.^(a())\1	%0Aaa%80
-	(.)^\1	%0A%0A
-	(a)$.\1	a%0Aa
-	x.(^a|a)\1	x%0Aaa
-	(|a)$\1|(a)\2	aa
-	(a)\>\1|(a)\2	aa
-	(a|\b)()$\1	aab
-	(^|\b)aab\1	aa%0Aaab
-	($|)$\1	a
-	(|()$)$\1	a
-	(a|\b)(b|bc|)(a|\b)(b|bc|)(a|\(^^^|||bC_d)()\1	aa|\(^^^|||bC_d)()\1%0Aa
u	(a|\b|bcka|||||())\1\'	)(c|bcd)(d*A%0AWbcd
i	(|a|%88|a|%88\||w|||Wb%01,B2Uv)$\1|||y|||((a|))\2	aa||aA)%FF%80|||

# In UTF-8, matches start inside a character only when glibc runs the
# pattern byte by byte: no REG_ICASE, word anchors, or brackets with a
# class, range, negation or multibyte character
u	%A5x[y]	%C3%A5xy
u	%A5x[^a]	%C3%A5xy
u	%A5x[a-z]	%C3%A5xy
u	%A5x\w	%C3%A5xy
u	%80x[^a]	%E2%80xy
u	%80x[^a]	%E2%80%80xy
u	%A5|^	%C3%A5
u	%A5[[.a.]]?	%C3%A5
iu	%A5	%C3%A5
u	%A5%20%C3%BC***.*[%C3%A5%BC].	%7F)[%C3%A5%20%C3%BC%C3%A5&%C2d%C3%BC].&%C3
u	%80(||y)?[%7F-%80[%80,].	%E2%80%80%7F^%D1qN%7F%11%04[fW+

# glibc's sifted states hold only nodes in its automaton's states: the
# original of a node an anchor copied is not one of them
-	()\1|$.	%0A
-	$.()\1|	%0A
-	^$.|()b\1	%0A%20a%20b
-	a(ab|a)\1(a|b)|($)(^|a)[^a].	%0Abaababb
# Without a span for a back-reference in its initial state, nothing
# after it can refer to the groups before it
-	^|(\B|)(^)\2.(\B|)\1.	ab
# Where an empty back-reference arrives, a newline the match consumed
# is no line start
-	.()\1^	%0A
-	x.()\1^	x%0A
-	.()\1(a|^)	%0A
-	.^	%0A
-	.()^	%0A
i	(a|\b).\1(^)	%0Axab%0A%0Aa%20
-	(a|\b)[^a]\1(^)	ababbbb%0A%0A
# glibc's retry of a shorter end takes a state holding an end node whose
# context fails as final, and ends the walk at node 0
-	\>(^|a)\1$|(a|b)$\>.	a%0A%20%20
-	($).(^)|\'(^)\3|)a	bx%0Aab%0Axba
