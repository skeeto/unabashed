# A hangup in eval, which bash runs with history off: no history is
# written, but the shell's jobs are hung up (pty only)
size 24 60
rc PS1='$ '
rc HISTFILE=~/hist
keys { sleep 30 & } 2>/dev/null; echo $! >~/pid\r
keys eval 'read x'\r
hangup
after cat ~/hist 2>&1
after i=0; while kill -0 $(cat ~/pid) 2>/dev/null && [ $i -lt 10 ]; do sleep 0.1; i=$((i+1)); done; kill -0 $(cat ~/pid) 2>/dev/null && echo alive || echo gone
after kill $(cat ~/pid) 2>/dev/null; true
