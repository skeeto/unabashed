# M-# (insert-comment), C-] and M-C-] (character search), M-C-e
# (shell-expand-line), M-^ (history-expand-line), bracketed paste,
# C-x C-x and the mark
size 16 60
rc PS1='$ '
rc x=expanded
keys echo hi\r
keys echo one\e#
snap
keys \C-p\e1\e#
snap
keys \C-u echo abcabc\C-a\C-]c\C-]c
snap
keys \e\C-]a
snap
keys \C-u echo $x !!\e\C-e
snap
keys \C-u echo !!:1\e^
snap
keys \C-u\e[200~echo pasted\rline\e[201~
snap
keys \C-u echo mark\C-@\C-a\C-x\C-x
snap
keys \C-u\r
snap
